# YCloud (console > Settings > API Keys)
YCLOUD_API_KEY=

# Secreto del webhook creado en YCloud Dashboard > Developer > Webhooks
YCLOUD_WEBHOOK_SECRET=

# Numero de WhatsApp de OCA en formato E.164 (ej: +573174004016)
WHATSAPP_BUSINESS_PHONE=

# Opcional: numero que recibe la notificacion de cada lead (formato E.164)
LEAD_NOTIFY_PHONE=

# Gemini (Google AI Studio: https://aistudio.google.com/apikey)
# Nota: gemini-2.5-flash ya no se ofrece a usuarios nuevos; usa 3.5-flash.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# PostgreSQL (Railway agrega esta variable automaticamente con su plugin)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oca_chatbot
